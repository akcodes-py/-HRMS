# ─── Django Core ───────────────────────────────────────────────────
SECRET_KEY=your-very-secret-key-change-this

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated trusted origins for CSRF (production frontend URL)
# CSRF_TRUSTED_ORIGINS=https://your-frontend-domain

# Set to False to force HTTPS redirect behind Railway's proxy.
# Leave True only if terminating TLS elsewhere.
# SECURE_SSL_REDIRECT=True

# ─── Database ──────────────────────────────────────────────────────
# Development (SQLite — default when DATABASE_URL is unset, no config needed)

# Production (PostgreSQL — Railway auto-injects this when the plugin is added)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── CORS ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Frontend (Vite) ───────────────────────────────────────────────
# Local dev: leave unset and Vite proxies /api to localhost:8000.
# Production: set to the public backend URL including the /api prefix.
# VITE_API_BASE_URL=https://your-backend.up.railway.app/api
